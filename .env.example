# Copy to .env.local (gitignored) and fill in. Vite exposes VITE_* variables to the page bundle.

# Client ID of your Spotify app (dashboard: https://developer.spotify.com/dashboard). Under PKCE it is not
# a secret, but it is personal: never commit it. Register http://127.0.0.1:5173/callback as a redirect URI.
VITE_SPOTIFY_CLIENT_ID=

# OpenAI-compatible endpoint (LM Studio or Ollama), including /v1, e.g. http://<host>:1234/v1.
# Its origin is added to the Content Security Policy's connect-src. Used from phase 2.
VITE_LLM_BASE_URL=
VITE_LLM_MODEL=
