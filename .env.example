# Copy to .env and fill in. Never commit .env.
# Authorization uses PKCE: no Client Secret is needed or read.
SPOTIFY_CLIENT_ID=

# Local OAuth callback port. The redirect URI is always http://127.0.0.1:<port>/callback
# and must be registered exactly (including the port) in the Spotify app dashboard.
# If you change the port, register the new URI there too (portless URIs are rejected).
SPOTIFY_REDIRECT_PORT=8888

# Optional: ISO 3166-1 alpha-2 market used for search/availability (e.g. AR).
# CURATUNE_MARKET=

# Optional: override where the OAuth token is stored (default: outside the repo,
# %LOCALAPPDATA%\curatune on Windows, $XDG_CONFIG_HOME/curatune or ~/.config/curatune elsewhere).
# CURATUNE_TOKEN_DIR=

# Optional: where curatune keeps its data: plans, backups, the write log, recording dates
# (default: %LOCALAPPDATA%\curatune\data on Windows, $XDG_DATA_HOME/curatune or ~/.local/share/curatune
# elsewhere). Must be outside the repository. Environment variables are expanded.
# CURATUNE_DATA_DIR=

# Optional: the source checkout whose .env is also read (default: the repository this package is installed
# from in editable mode). Neither the token nor the data may live inside it.
# CURATUNE_PROJECT_DIR=

# Optional (MCP server): how plan_apply asks the person to confirm: auto (default), elicitation, or browser.
# CURATUNE_MCP_CONFIRM=auto
