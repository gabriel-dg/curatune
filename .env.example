# Copy to .env.local (gitignored) and fill in. Vite exposes VITE_* variables to the page bundle.

# Client ID of your Spotify app (dashboard: https://developer.spotify.com/dashboard). Under PKCE it is not
# a secret, but it is personal: never commit it. Register http://127.0.0.1:5173/callback as a redirect URI.
VITE_SPOTIFY_CLIENT_ID=

# OpenAI-compatible endpoint (LM Studio or Ollama), including /v1, e.g. http://<host>:1234/v1.
# Its origin is added to the Content Security Policy's connect-src. Used from phase 2.
VITE_LLM_BASE_URL=
VITE_LLM_MODEL=

# Optional hosted LLM (OpenAI-compatible), selectable in the chat next to the local one. Example: Gemini,
# https://generativelanguage.googleapis.com/v1beta/openai with models such as
# gemini-3.8-flash,gemini-3.5-flash-lite (comma separated: each one appears in the model selector, all
# sharing one API key). Its origin is added to the CSP. The API key is NOT configured here: the app asks for
# it and keeps it in the tab's sessionStorage. Using it sends the conversation and playlist data to that
# provider.
VITE_HOSTED_LLM_BASE_URL=
VITE_HOSTED_LLM_MODEL=
VITE_HOSTED_LLM_NAME=
